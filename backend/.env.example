# Copy to backend/.env (never committed) and fill in.
MONGO_URL=mongodb://localhost:27017
MONGO_DB=dressme
# a long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_HOURS=72
# from https://aistudio.google.com/ (needed only for /chat)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGINS=http://localhost:5173
