# Copy to backend/.env (never committed) and fill in.
MONGO_URL=mongodb://localhost:27017
MONGO_DB=dressme
# a long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_HOURS=72
# 1 = remove the background of uploaded photos (rembg), 0 = keep it
REMOVE_BACKGROUND=1
BACKGROUND_MODEL=u2net
# keeps only the garment when the photo shows someone wearing it (empty = off)
CLOTH_MODEL=u2net_cloth_seg
# virtual try-on: space (Hugging Face Spaces; the user's photo is sent there) or off
TRYON_ENGINE=space
# tried in order; check their state with: python -m app.tryon --check
# a copy of a Space under another name: owner/name=catvton (or =idm, =kolors, =ootd)
TRYON_SPACES=zhengchong/CatVTON, Kwai-Kolors/Kolors-Virtual-Try-On, yisol/IDM-VTON, levihsu/OOTDiffusion
TRYON_STEPS=30
# optional, from https://huggingface.co/settings/tokens (read access): bigger free GPU quota
HF_TOKEN=
# today's weather for the Today page: open-meteo (free, no key; rounded position sent) or off
WEATHER_ENGINE=open-meteo
# place used when the app sends no position
WEATHER_LAT=36.81
WEATHER_LON=10.18
WEATHER_PLACE=Tunis
CORS_ORIGINS=http://localhost:5173
# the assistant's model in Ollama (pull it first: ollama pull qwen3.5:4b). Teammates short of disk space may use
# dressme-chat-v4 instead; only qwen3.5:4b is evaluated (docs/superpowers/handoff/assistant-model.md)
CHAT_MODEL=qwen3.5:4b
# where Ollama answers; host.docker.internal = this PC seen from the backend container
# (without Docker: http://localhost:11434)
OLLAMA_URL=http://host.docker.internal:11434
